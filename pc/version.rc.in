// Version resource template; pc/build.sh fills in @VER@, @VERC@, @DESC@, @FILE@.
#include <windows.h>
VS_VERSION_INFO VERSIONINFO
FILEVERSION @VERC@
PRODUCTVERSION @VERC@
FILEOS 0x40004
FILETYPE @TYPE@
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "PhoneCam project"
      VALUE "FileDescription", "@DESC@"
      VALUE "FileVersion", "@VER@"
      VALUE "InternalName", "@FILE@"
      VALUE "OriginalFilename", "@FILE@"
      VALUE "ProductName", "PhoneCam"
      VALUE "ProductVersion", "@VER@"
      VALUE "LegalCopyright", "MIT License, github.com/convicted3/PhoneCam"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
